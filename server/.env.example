APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://flowriver:local-only-change-this@127.0.0.1:5432/flowriver_test?sslmode=disable

# Generate independent 32-byte keys and base64-encode them.
AUTH_HMAC_KEY=
OUTBOX_ENCRYPTION_KEY=
IDEMPOTENCY_ENCRYPTION_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_AUDIT_HMAC_KEY=

TERMS_VERSION=terms-1
PRIVACY_VERSION=privacy-1

# Local development defaults. Production requires SMTP; Apple is optional via ACCOUNT_AUTH_MODE.
EMAIL_MODE=console
SMTP_ADDR=localhost:465
SMTP_TLS_MODE=implicit
# For a local outbound Postfix MTA instead, use 127.0.0.1:25 and loopback mode.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=account@mail.flowriver.xyz

APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
APPLE_CLIENT_IDS=
APPLE_ENABLED=false
ACCOUNT_AUTH_MODE=email_and_apple

# Disabled during local development until keys and an administrator are provisioned.
ADMIN_ENABLED=false
ADMIN_LISTEN_ADDR=127.0.0.1:8081
ADMIN_ORIGIN=http://127.0.0.1:5173
ADMIN_ALLOWED_IPS=

# Default: production requires an off-host journal. login_only enables auth only;
# account deletion, identity revocation and Apple revocation notifications stay unavailable.
SECURITY_JOURNAL_MODE=offsite
SECURITY_JOURNAL_ENDPOINT=
SECURITY_JOURNAL_TOKEN=
SECURITY_JOURNAL_SIGNING_KEY=

# 管理台「下载管理」上传安装包的目录(可选;指向 Caddy 对外提供 /downloads/ 的目录后,
# 官网下载卡片与 /v1/site-status 由该目录状态驱动)
# DOWNLOAD_DIR=/var/www/flowriver/site/downloads
